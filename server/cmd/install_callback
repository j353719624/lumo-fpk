#!/bin/bash
# 安装后处理：
#   1) 用向导里的端口与控制台账号生成服务端配置（lumoc server 子命令，
#      格式与代码始终一致）；
#   2) 隧道密钥由服务端自动生成：配置里只写派生公钥，明文密钥写入
#      数据目录 tunnel-secret.txt（0600），客户端连接时用；
#   3) 控制台密码留空时自动生成，安装日志里可以看到。
#
# 口令安全：控制台密码与 Basic 密码先经 `lumoc hashpass` 转成 PBKDF2
# 哈希再写入 lumos.toml —— 配置文件被读走也拿不到可用密码。
#
# 注意：飞牛的 password 类型字段不会作为环境变量传给安装脚本，
# 所以向导里凡是需要参与配置的字段一律用 text 类型。

set -u

APPDEST="${TRIM_APPDEST:-}"
PKGVAR="${TRIM_PKGVAR:-}"
LUMOC="${APPDEST}/bin/lumoc"
TOML="${PKGVAR}/lumos.toml"
SECRET_FILE="${PKGVAR}/tunnel-secret.txt"

fail() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$1" >>"${TRIM_TEMP_LOGFILE}"
    fi
    printf '%s\n' "$1" >&2
    exit 1
}

say() {
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$1" >>"${TRIM_TEMP_LOGFILE}"
    fi
    printf '%s\n' "$1" >&2
}

genpw() {
    local pw
    pw="$(head -c 24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 20)"
    [ -n "${pw}" ] || pw="lumo$(date +%s)"
    printf '%s' "${pw}"
}

hashpw() {
    "${LUMOC}" hashpass "$1" || fail "LUMO 服务端安装失败：口令哈希生成出错"
}

[ -n "${PKGVAR}" ] || fail "LUMO 服务端安装失败：缺少 TRIM_PKGVAR"
[ -x "${LUMOC}" ] || fail "LUMO 服务端安装失败：缺少程序 ${LUMOC}"

mkdir -p "${PKGVAR}" || fail "LUMO 服务端安装失败：无法创建数据目录 ${PKGVAR}"

BIND_PORT="${bindPort:-58619}"
KCP_PORT="${kcpPort:-47011}"
VHOST_PORT="${vhostHTTPPort:-18080}"
CUSER="${webUser:-admin}"
CPASS="${webPass:-}"
# 三层防护最外层凭证（HTTP Basic Auth，独立于面板密码）
BUSER="${basicUser:-lumo}"
BPASS="${basicPass:-}"

# 首次安装：生成服务端配置与隧道密钥
if [ ! -f "${TOML}" ]; then
    GENERATED_CONSOLE=0
    if [ -z "${CPASS}" ]; then
        CPASS="$(genpw)"
        GENERATED_CONSOLE=1
    fi
    GENERATED_BASIC=0
    if [ -z "${BPASS}" ]; then
        BPASS="$(genpw)"
        GENERATED_BASIC=1
    fi
    CPASS_HASH="$(hashpw "${CPASS}")"
    BPASS_HASH="$(hashpw "${BPASS}")"
    ARGS=(server --out "${TOML}" --bind-port "${BIND_PORT}" --kcp-port "${KCP_PORT}" \
        --vhost-port "${VHOST_PORT}" --web-user "${CUSER}" \
        --web-pass "${CPASS_HASH}" \
        --web-basic-user "${BUSER}" --web-basic-pass "${BPASS_HASH}")
    OUT="$("${LUMOC}" "${ARGS[@]}")" || fail "LUMO 服务端安装失败：生成配置出错"
    SECRET=$(printf '%s\n' "${OUT}" | sed -n 's/^SECRET=//p')

    if [ -n "${SECRET}" ]; then
        printf '%s' "${SECRET}" > "${SECRET_FILE}"
        chmod 600 "${SECRET_FILE}"
        say "隧道密钥已生成，保存在数据目录 tunnel-secret.txt（客户端连接时使用，请妥善保管）"
    fi
    if [ "${GENERATED_CONSOLE}" -eq 1 ]; then
        say "控制台账号：${CUSER}"
        say "控制台密码：${CPASS}"
    else
        say "控制台账号：${CUSER}（密码为你安装时设置的）"
    fi
    if [ "${GENERATED_BASIC}" -eq 1 ]; then
        say "Basic 认证账号：${BUSER}（密码：${BPASS}）"
    else
        say "Basic 认证账号：${BUSER}（密码为你安装时设置的）"
    fi
    say "服务端口：${BIND_PORT}  KCP 端口：${KCP_PORT}  HTTP 端口：${VHOST_PORT}"
else
    # 重装/升级：toml 已存在。旧版安装可能没有 Basic 层键——补进
    # [webServer] 表，不再静默丢弃向导输入。
    if ! grep -q '^basicUser' "${TOML}"; then
        GENERATED_BASIC=0
        if [ -z "${BPASS}" ]; then
            BPASS="$(genpw)"
            GENERATED_BASIC=1
        fi
        BPASS_HASH="$(hashpw "${BPASS}")"
        sed -i "/^password = /a basicUser = \"${BUSER}\"\nbasicPassword = \"${BPASS_HASH}\"" "${TOML}"
        chmod 600 "${TOML}"
        if [ "${GENERATED_BASIC}" -eq 1 ]; then
            say "Basic 认证账号：${BUSER}（密码：${BPASS}）"
        else
            say "Basic 认证账号：${BUSER}（密码为你安装时设置的）"
        fi
    elif [ -n "${BPASS}" ]; then
        # 已有 Basic 层且向导里重新填了：以向导为准
        BPASS_HASH="$(hashpw "${BPASS}")"
        sed -i "s|^basicUser = .*|basicUser = \"${BUSER}\"|; s|^basicPassword = .*|basicPassword = \"${BPASS_HASH}\"|" "${TOML}"
        chmod 600 "${TOML}"
        say "Basic 认证账号：${BUSER}（密码为你安装时设置的）"
    fi
fi
chmod 600 "${TOML}" 2>/dev/null || true

say "LUMO 服务端安装完成"
say "入口：飞牛桌面 → LUMO 服务端；局域网浏览器访问 http://本机IP:46351"

exit 0
