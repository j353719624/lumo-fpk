#!/bin/bash
# 卸载后：确保进程全部收掉；按卸载向导选项决定是否清数据。

set -u

APPDEST="${TRIM_APPDEST:-}"
PKGVAR="${TRIM_PKGVAR:-}"
MAIN="${APPDEST}/cmd/main"

if [ -x "${MAIN}" ]; then
    "${MAIN}" stop >/dev/null 2>&1 || true
fi

if [ -n "${APPDEST}" ]; then
    pkill -f "${APPDEST}/bin/lumoc" 2>/dev/null || true
    # watchdog 的 cmdline 是 "bash <路径>/cmd/main watchdog"，binary 模式
    # 匹配不到；数据删除后 pid 文件也没了，必须按应用名清脚本进程
    pkill -f "$(basename "${APPDEST}")/cmd/main" 2>/dev/null || true
    sleep 1
    pkill -9 -f "${APPDEST}/bin/lumoc" 2>/dev/null || true
    pkill -9 -f "$(basename "${APPDEST}")/cmd/main" 2>/dev/null || true
fi

# console.env 属于「保留配置」的一部分：留着它，重装后控制台密码不变。
# 只有向导选了「清除全部数据」时才随整个数据目录一起删除。
rm -f "${PKGVAR}/"*.pid "${PKGVAR}/"*.pgid 2>/dev/null || true

if [ "${wizard_delete_data:-false}" = "true" ]; then
    rm -rf "${PKGVAR}" 2>/dev/null || true
fi

exit 0
